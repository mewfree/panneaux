{
  "name": "@panneaux/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-seo-assets.mjs && vite",
    "build": "node scripts/generate-seo-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:only": "wrangler deploy",
    "seo:assets": "node scripts/generate-seo-assets.mjs",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "minisearch": "^7.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.7.0",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@tailwindcss/vite": "^4.1.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.20.0"
  }
}
